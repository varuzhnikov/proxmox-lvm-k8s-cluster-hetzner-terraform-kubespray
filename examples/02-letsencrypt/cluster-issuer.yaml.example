---
# Let's Encrypt Staging ClusterIssuer (for testing)
# Use this for development/testing to avoid rate limits
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-staging
spec:
  acme:
    # Let's Encrypt staging server (doesn't issue trusted certificates)
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: your-email@example.com  # CHANGE THIS to your actual email
    # Secret to store ACME account private key
    privateKeySecretRef:
      name: letsencrypt-staging
    # HTTP-01 challenge solver
    solvers:
    - http01:
        ingress:
          ingressClassName: haproxy
---
# Let's Encrypt Production ClusterIssuer (for production)
# Use this for production certificates
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    # Let's Encrypt production server
    server: https://acme-v02.api.letsencrypt.org/directory
    email: your-email@example.com  # CHANGE THIS to your actual email
    # Secret to store ACME account private key
    privateKeySecretRef:
      name: letsencrypt-prod
    # HTTP-01 challenge solver
    solvers:
    - http01:
        ingress:
          ingressClassName: haproxy
