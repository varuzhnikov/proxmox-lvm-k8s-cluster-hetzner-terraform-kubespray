# ============================================================================
# HAProxy Configuration for Kubernetes Cluster Load Balancing
# Generated by Terraform - Do not edit manually
# ============================================================================

# ----------------------------------------------------------------------------
# Global Configuration
# ----------------------------------------------------------------------------
global
    # Log to syslog using local0 facility for general logs
    log /dev/log    local0
    # Log to syslog using local1 facility with notice level for important events
    log /dev/log    local1 notice
    # Chroot to /var/lib/haproxy for security isolation
    chroot /var/lib/haproxy
    # Create admin socket for runtime API access (for stats and management)
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    # Timeout for stats socket operations
    stats timeout 30s
    # Run HAProxy as haproxy user (non-root for security)
    user haproxy
    # Run HAProxy as haproxy group
    group haproxy
    # Run as daemon (background process)

# ----------------------------------------------------------------------------
# Default Configuration (applies to all frontends/backends unless overridden)
# ----------------------------------------------------------------------------
defaults
    # Use global log settings defined above
    log     global
    # Use TCP mode (layer 4 load balancing) - required for Kubernetes API and TCP services
    mode    tcp
    # Enable TCP logging to capture connection details
    option  tcplog
    # Don't log null connections (connections that close immediately)
    option  dontlognull
    # Maximum time to wait for a connection attempt to a backend server
    timeout connect 5000ms
    # Maximum time a client can remain idle before HAProxy closes the connection
    timeout client  50000ms
    # Maximum time a server can remain idle before HAProxy closes the connection
    timeout server  50000ms

# ----------------------------------------------------------------------------
# Frontend: Kubernetes API Server Load Balancer
# ----------------------------------------------------------------------------
# Listens on localhost:6443 and forwards to control plane nodes
frontend kube_api_frontend
    # Bind to localhost (127.0.0.1) on port 6443 - only accessible from Proxmox host
    # This ensures Kubernetes API is only accessible locally for security
    bind 127.0.0.1:6443
    # Use TCP mode for Kubernetes API (which uses HTTPS/TLS)
    mode tcp
    # Forward all traffic to the kube_api_backend
    default_backend kube_api_backend

# ----------------------------------------------------------------------------
# Backend: Kubernetes Control Plane Nodes
# ----------------------------------------------------------------------------
# Load balances Kubernetes API requests across all control plane nodes
backend kube_api_backend
    # Use TCP mode to match frontend
    mode tcp
    # Use round-robin balancing algorithm (distribute requests evenly)
    balance roundrobin
    # Enable TCP health checks to verify backend servers are responding
    option tcp-check
%{ for control_plane in control_planes ~}
    # Server definition: name, IP:port, enable health checks
    # check: Enable health checking for this server
    server ${control_plane.name} ${control_plane.ip}:6443 check
%{ endfor ~}

# ----------------------------------------------------------------------------
# Frontend: Worker Node Services Load Balancer
# ----------------------------------------------------------------------------
# Listens on all interfaces (0.0.0.0) on port 443 and forwards to worker nodes
frontend worker_services_frontend
    # Bind to all interfaces (0.0.0.0) on port 443 - accessible from anywhere
    # This allows external access to services running on worker nodes
    bind 0.0.0.0:443
    # Use TCP mode for generic TCP load balancing
    mode tcp
    # Forward all traffic to the worker_services_backend
    default_backend worker_services_backend

# ----------------------------------------------------------------------------
# Backend: Worker Nodes
# ----------------------------------------------------------------------------
# Load balances service traffic across all worker nodes
backend worker_services_backend
    # Use TCP mode to match frontend
    mode tcp
    # Use round-robin balancing algorithm (distribute requests evenly)
    balance roundrobin
    # Enable TCP health checks to verify backend servers are responding
    option tcp-check
%{ for worker in workers ~}
    # Server definition: name, IP:port, enable health checks
    # check: Enable health checking for this server
    server ${worker.name} ${worker.ip}:443 check
%{ endfor ~}
