# ============================================================================
# HAProxy Configuration for Kubernetes Cluster Load Balancing
# Generated by Terraform - Do not edit manually
# ============================================================================

# ----------------------------------------------------------------------------
# Global Configuration
# ----------------------------------------------------------------------------
global
    # Log to syslog using local0 facility for general logs
    log /dev/log    local0
    # Log to syslog using local1 facility with notice level for important events
    log /dev/log    local1 notice
    # Chroot to /var/lib/haproxy for security isolation
    chroot /var/lib/haproxy
    # Create admin socket for runtime API access (for stats and management)
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    # Timeout for stats socket operations
    stats timeout 30s
    # Run HAProxy as haproxy user (non-root for security)
    user haproxy
    # Run HAProxy as haproxy group
    group haproxy
    # Run as daemon (background process)

# ----------------------------------------------------------------------------
# Default Configuration (applies to all frontends/backends unless overridden)
# ----------------------------------------------------------------------------
defaults
    # Use global log settings defined above
    log     global
    # Use TCP mode (layer 4 load balancing) - required for Kubernetes API and TCP services
    mode    tcp
    # Enable TCP logging to capture connection details
    option  tcplog
    # Don't log null connections (connections that close immediately)
    option  dontlognull
    # Maximum time to wait for a connection attempt to a backend server
    timeout connect 5000ms
    # Maximum time a client can remain idle before HAProxy closes the connection
    # Reasonable timeout to prevent resource exhaustion without being too aggressive
    timeout client  30000ms
    # Maximum time a server can remain idle before HAProxy closes the connection
    timeout server  30000ms
    # Maximum time to wait for HTTP request (prevent slowloris attacks)
    timeout http-request 15s
    # Maximum time to wait for HTTP response
    timeout http-keep-alive 10s

# ----------------------------------------------------------------------------
# Frontend: Kubernetes API Server Load Balancer
# ----------------------------------------------------------------------------
# Listens on localhost:6443 and forwards to control plane nodes
frontend kube_api_frontend
    # Bind to localhost (127.0.0.1) on port 6443 - only accessible from Proxmox host
    # This ensures Kubernetes API is only accessible locally for security
    bind 127.0.0.1:6443
    # Use TCP mode for Kubernetes API
    mode tcp
    # Forward all traffic to the kube_api_backend
    default_backend kube_api_backend

# ----------------------------------------------------------------------------
# Backend: Kubernetes Control Plane Nodes
# ----------------------------------------------------------------------------
# Load balances Kubernetes API requests across all control plane nodes
backend kube_api_backend
    # Use TCP mode to match frontend
    mode tcp
    # Use least connection balancing algorithm (send requests to server with fewest active connections)
    balance leastconn
    # Enable automatic retry on another server if current server fails
    option redispatch
    # Enable TCP health checks to verify backend servers are responding
    option tcp-check
    # Health check interval: check every 2 seconds
    # fall: mark server down after 2 consecutive failures
    # rise: mark server up after 2 consecutive successes
    # inter: interval between health checks
    # Server definition: name, IP:port, enable health checks with fast failure detection
    # check: Enable health checking for this server
    # inter 2s: check every 2 seconds
    # fall 2: mark down after 2 failures
    # rise 2: mark up after 2 successes
    # fastinter 1s: faster checks when server is down
%{ for control_plane in control_planes ~}
    server ${control_plane.name} ${control_plane.ip}:6443 check inter 2s fall 2 rise 2 fastinter 1s
%{ endfor ~}

# ----------------------------------------------------------------------------
# Frontend: HTTP Services (Port 80) - For Let's Encrypt HTTP-01 challenge and redirect to HTTPs
# ----------------------------------------------------------------------------
# Listens on all interfaces (0.0.0.0) on port 80 and forwards to https
# Port 80 is REQUIRED for Let's Encrypt HTTP-01 challenge validation
frontend worker_http_frontend
    # Bind to all interfaces (0.0.0.0) on port 80 - accessible from anywhere
    # This allows Let's Encrypt to validate domain ownership via HTTP-01 challenge
    bind 0.0.0.0:80
    # Use HTTP mode to inspect Host header and path for filtering
    mode http
    # Enable HTTP logging
    option httplog
    # Don't log null connections
    option dontlognull

    # Block httpoxy attacks; prevents redirecting internal server traffic to an attacker
    http-request del-header Proxy
    
    # Forward real client IP to backend (for logging and access control in cluster)
    option forwardfor
    http-request set-header X-Real-IP %[src]
    http-request set-header X-Forwarded-Proto http
    
    # Step 1: Domain filtering - check if domain is in allowed list
    # Read allowed domains from file (exact matches)
    acl allowed_domain_exact hdr(host) -f /etc/haproxy/allow_domains.txt
    
    # Wildcard domain matching (e.g., *.example.com)
    # This matches domains ending with patterns from the file
    # Note: For wildcards like *.example.com, the file should contain .example.com
    # HAProxy will match any subdomain ending with .example.com
    acl allowed_domain_wildcard hdr_end(host) -f /etc/haproxy/allow_domains.txt
    
    # Step 2: Check if request is for Let's Encrypt HTTP-01 challenge
    # Let's Encrypt uses /.well-known/acme-challenge/ path for validation
    acl is_letsencrypt_challenge path_beg /.well-known/acme-challenge/
    
    # Rule 1: Block requests from domains NOT in allowed list
    # This must be checked first - reject unauthorized domains immediately
    # Domain is allowed if it matches exactly OR matches wildcard pattern
    http-request deny if !allowed_domain_exact !allowed_domain_wildcard
    
    # Rule 3: Route other ACME challenges to worker backend
    use_backend worker_http_backend if is_letsencrypt_challenge
    
    # Rule 4: Redirect allowed to HTTPS (if not ACME)
    http-request redirect scheme https code 301 if !is_letsencrypt_challenge
    
    # Default backend (should not be reached, but kept for safety)
    default_backend worker_http_backend

# ----------------------------------------------------------------------------
# Frontend: HTTPS Services (Port 443) - For encrypted traffic
# ----------------------------------------------------------------------------
# Listens on all interfaces (0.0.0.0) on port 443 and forwards to worker nodes
# TCP mode with SNI inspection for domain filtering without SSL termination
frontend worker_https_frontend
    # Bind to all interfaces (0.0.0.0) on port 443 - accessible from anywhere
    # This allows external access to HTTPS services running on worker nodes
    bind 0.0.0.0:443
    # Use TCP mode for SSL passthrough (maintains end-to-end encryption)
    mode tcp
    # Enable TCP logging
    option tcplog
    
    # Wait for SNI to be extracted from TLS handshake before making decisions
    # This is critical for SNI-based filtering in TCP mode
    # SNI appears early in TLS handshake, but we need to wait for it to be parsed
    # 
    # Performance note: This is NOT a blocking delay - HAProxy continues processing
    # as soon as SNI is extracted (typically within first few packets, ~1-5ms).
    # The 5s value is a maximum timeout, not an actual wait time.
    # Real overhead: ~1-5ms per connection (time to receive and parse SNI from TLS handshake)
    # This is negligible compared to TLS handshake time (~50-200ms) and network latency.
    tcp-request inspect-delay 5s
    
    # Domain filtering via SNI (Server Name Indication)
    # This inspects the TLS handshake to extract the domain name
    # without terminating SSL, maintaining end-to-end encryption
    
    # Exact domain matching from file
    acl allowed_domain_exact req_ssl_sni -f /etc/haproxy/allow_domains.txt
    
    # Wildcard domain matching using suffix matching
    # This matches domains ending with patterns from the file (e.g., *.example.com)
    # Note: For wildcards like *.example.com, the file should contain .example.com
    # HAProxy will match any subdomain ending with .example.com
    # Use -m end for suffix matching with file lookup
    acl allowed_domain_wildcard req_ssl_sni -m end -f /etc/haproxy/allow_domains.txt
    
    # Reject connections that don't match allowed domains
    # This blocks unauthorized domain access before traffic reaches the cluster
    # 
    # Behavior with slow connections:
    # - If SNI is not extracted within inspect-delay (5s), req_ssl_sni -m found returns false
    # - Connection is rejected (security: blocks non-HTTPS or malicious traffic)
    # - This is acceptable because legitimate HTTPS clients send SNI in first packet (~1-5ms)
    # - Very slow connections (>5s for first packet) are extremely rare and likely malicious
    # 
    # Alternative: To allow connections without SNI (less secure), change condition to:
    # tcp-request content reject if { req_ssl_sni -m found } && !allowed_domain_exact !allowed_domain_wildcard
    # This would allow connections without SNI but reject known bad domains
    tcp-request content reject if !{ req_ssl_sni -m found } || !allowed_domain_exact !allowed_domain_wildcard
    
    # Forward allowed traffic to the worker_https_backend
    default_backend worker_https_backend

# ----------------------------------------------------------------------------
# Backend: Worker Nodes HTTP (NodePort 30080)
# ----------------------------------------------------------------------------
# Load balances HTTP service traffic across all worker nodes
# Traffic is forwarded to HAProxy Ingress Controller via NodePort Service
# NodePort 30080 is used instead of direct port 80 for better Pod isolation
backend worker_http_backend
    # Use HTTP mode to match frontend
    mode http
    # Use least connection balancing algorithm (send requests to server with fewest active connections)
    balance leastconn
    # Enable automatic retry on another server if current server fails
    option redispatch
    # Enable TCP health checks to verify backend servers are responding
    option tcp-check
    # Faster timeout for health checks (fail quickly if node is down)
    timeout check 2s
    # Health check interval: check every 2 seconds
    # fall: mark server down after 2 consecutive failures
    # rise: mark server up after 2 consecutive successes
    # inter: interval between health checks
%{ for worker in workers ~}
    # Server definition: name, IP:port, enable health checks with fast failure detection
    # check: Enable health checking for this server
    # inter 2s: check every 2 seconds
    # fall 2: mark down after 2 failures
    # rise 2: mark up after 2 successes
    # NodePort 30080 on worker nodes routes to HAProxy Ingress Controller Service
    server ${worker.name} ${worker.ip}:30080 check inter 2s fall 2 rise 2
%{ endfor ~}

# ----------------------------------------------------------------------------
# Backend: Worker Nodes HTTPS (NodePort 30443)
# ----------------------------------------------------------------------------
# Load balances HTTPS service traffic across all worker nodes
# Traffic is forwarded to HAProxy Ingress Controller via NodePort Service
# NodePort 30443 is used instead of direct port 443 for better Pod isolation
backend worker_https_backend
    # Use TCP mode to match frontend (SSL passthrough)
    mode tcp
    # Use least connection balancing algorithm (send requests to server with fewest active connections)
    balance leastconn
    # Enable automatic retry on another server if current server fails
    option redispatch
    # Faster timeout for health checks (fail quickly if node is down)
    timeout check 2s
    # Note: For SSL passthrough, we use basic TCP connection checks
    # HAProxy will detect unavailable servers reactively:
    # - Connection failures (refused, timeout, network errors) mark server as DOWN
    # - HAProxy automatically retries on other servers and excludes failed ones
    # - Servers are periodically re-checked and restored when they become available
    # This is reactive (on real requests) rather than proactive (periodic checks).
%{ for worker in workers ~}
    # Server definition: name, IP:port, basic TCP connection check
    # check: Enable basic TCP connection check (not full SSL validation)
    # inter 2s: check connection every 2 seconds
    # fall 2: mark down after 2 connection failures
    # rise 2: mark up after 2 successful connections
    # fastinter 1s: faster checks when server is down
    # NodePort 30443 on worker nodes routes to HAProxy Ingress Controller Service
    server ${worker.name} ${worker.ip}:30443 check inter 2s fall 2 rise 2 fastinter 1s
%{ endfor ~}
